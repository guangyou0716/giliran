# Copy to .env (never commit .env) and export the variables before running.
DJANGO_DEBUG=1
# Required when DJANGO_DEBUG=0. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# PostgreSQL (recommended). Leave empty to use local SQLite (db.sqlite3).
DATABASE_URL=postgres://giliran:giliran@localhost:5432/giliran
# Live update interval for the ticket page and the display board (ms).
GILIRAN_POLL_MS=5000
# Password used by `manage.py seed_demo` for the synthetic demo accounts.
GILIRAN_DEMO_PASSWORD=
