# Copy to .env (never commit .env) and export the variables before running.
DJANGO_DEBUG=1
# Required when DJANGO_DEBUG=0. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# PostgreSQL (recommended). Leave empty to use local SQLite (db.sqlite3).
DATABASE_URL=postgres://giliran:giliran@localhost:5432/giliran
# Polling interval (ms) for the ticket page and display board when a live stream is unavailable.
GILIRAN_POLL_MS=5000
# Live updates by Server-Sent Events (0 = polling only). Each open stream holds a worker
# thread for up to GILIRAN_SSE_MAX_SECONDS: run gunicorn with --worker-class gthread --threads N.
GILIRAN_SSE=1
GILIRAN_SSE_MAX_SECONDS=60
# "Almost your turn" alert on the ticket page at this many people ahead.
GILIRAN_ALMOST_AHEAD=2
# Password used by `manage.py seed_demo` for the synthetic demo accounts.
GILIRAN_DEMO_PASSWORD=
# Appointments: on-time check-in grace after slot start, self check-in opens N minutes
# before the slot, and how many days ahead customers can book.
GILIRAN_BOOKING_GRACE_MIN=10
GILIRAN_CHECKIN_EARLY_MIN=30
GILIRAN_BOOKING_DAYS=7
# Rate limit on the public join and booking forms: at most MAX POSTs per client IP per WINDOW
# seconds, then HTTP 429 with a friendly page. 0 disables. Set GILIRAN_TRUST_PROXY=1 only behind a
# reverse proxy you control (the client IP is then the last X-Forwarded-For entry).
GILIRAN_RATE_LIMIT_MAX=10
GILIRAN_RATE_LIMIT_WINDOW=60
GILIRAN_TRUST_PROXY=0
# `python manage.py purge_phones` (daily cron) blanks booking phone numbers older than this.
GILIRAN_PHONE_RETENTION_DAYS=30
# Docker Compose only: set DJANGO_SECRET_KEY above, optionally POSTGRES_PASSWORD, GILIRAN_PORT (8000),
# GILIRAN_SEED_DEMO=1 (needs GILIRAN_DEMO_PASSWORD), DJANGO_SECURE_COOKIES (0 for plain http://localhost),
# DJANGO_CSRF_TRUSTED_ORIGINS=https://your.domain
